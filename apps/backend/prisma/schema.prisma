// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum League {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

// Subscription tiers.
//
// Only two exist today. The tier is an enum rather than a boolean, and every
// limit is looked up by tier in entitlement.service, so adding a middle tier
// later is a new enum value plus config rows — no rewrite of the call sites.
enum Tier {
  FREE
  PREMIUM
}

// Where a premium grant came from. ADMIN covers both a hand-typed grant and
// one an admin approved in the payment bot; the providers are placeholders for
// the automated webhook stage.
enum GrantSource {
  ADMIN
  TELEGRAM
  PAYME
  CLICK
}

// Lifecycle of a bot purchase.
//
//   PENDING   — the web app created it, the buyer has not opened the bot yet
//   AWAITING  — bot opened, card details shown, waiting for the receipt photo
//   SUBMITTED — receipt received and forwarded to the admin chat
//   APPROVED  — admin confirmed; a PremiumGrant exists
//   REJECTED  — admin declined, with a reason sent back to the buyer
//   EXPIRED   — never completed before expiresAt
enum PaymentStatus {
  PENDING
  AWAITING
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum BadgeType {
  STREAK
  WORDS_SAVED
  GAMES_PLAYED
  PERFECT_GAME
  MASTER_WORDS
  COINS_EARNED
  WORDS_REVIEWED
}

enum GameType {
  TEST
  MATCH
  WRITE
  SHOOTER
  // Block-puzzle mode: a vocabulary question gates each new set of pieces.
  BLOCKS
  // Combined review mode: 20 rounds, each randomly TEST, MATCH or WRITE.
  // This is the mode the dashboard's SRS review button points at.
  MIXED
}

// ─── Core Auth ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  phone        String?  @unique
  telegramId   String?  @unique @map("telegram_id")
  passwordHash String?  @map("password_hash") // Optional: social login users have no password
  googleId     String?  @unique @map("google_id") // Google OAuth ID
  avatarUrl    String?  @map("avatar_url") // Profile picture from Google
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")

  // ── Subscription ──
  // `tier` is the effective tier and `premiumUntil` is when it lapses.
  // A PREMIUM user with premiumUntil = null holds a lifetime grant; the daily
  // cron only downgrades rows where the date has actually passed.
  tier         Tier      @default(FREE)
  premiumUntil DateTime? @map("premium_until")

  profile          Profile?
  words            Word[]             @relation("AuthorWords")
  savedWords       SavedWord[]
  savedBooks       SavedBook[]
  savedTopics      SavedTopic[]
  wordProgress     UserWordProgress[]
  weeklyStats      WeeklyStat[]
  badges           UserBadge[]
  gameSessions     GameSession[]
  authSessions     AuthSession[]
  wordNotes        UserWordNote[]
  refreshTokens    RefreshToken[]
  books            Book[]             @relation("AuthoredBooks")
  topics           Topic[]            @relation("AuthoredTopics")
  premiumGrants    PremiumGrant[]     @relation("GrantRecipient")
  grantsIssued     PremiumGrant[]     @relation("GrantIssuer")
  payments         PaymentRequest[]   @relation("PaymentBuyer")
  paymentsReviewed PaymentRequest[]   @relation("PaymentReviewer")
  jlptAttempts     JlptAttempt[]

  @@map("users")
}

// A purchase started in the web app and completed in the Telegram bot.
//
// The buyer transfers the money to a card out of band and sends the receipt to
// the bot; an admin approves it there and `grantPremium` runs. The row is the
// audit trail for that exchange — who bought what, which receipt, who approved.
//
// `linkToken` is what ties the two halves together: the web app mints it, the
// deep link carries it into the bot, and the bot resolves it back to a user.
// That avoids ever asking the buyer to type their username into a chat, which
// nobody gets right and anybody could fake.
model PaymentRequest {
  id     String        @id @default(cuid())
  userId String        @map("user_id")
  /// 'monthly' | 'yearly' | 'lifetime' — which price row was chosen.
  plan   String
  /// Whole months to grant on approval. 0 = lifetime.
  months Int
  /// Price in so'm, frozen at checkout so a later price change cannot alter it.
  amount Int
  status PaymentStatus @default(PENDING)

  linkToken      String  @unique @map("link_token")
  telegramUserId String? @map("telegram_user_id")
  telegramChatId String? @map("telegram_chat_id")
  /// Telegram file_id of the receipt — the image itself stays on Telegram.
  receiptFileId  String? @map("receipt_file_id")

  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  rejectReason String?   @map("reject_reason")
  /// The grant created on approval, so a refund can find what to revoke.
  grantId      String?   @map("grant_id")

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  user       User  @relation("PaymentBuyer", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("payment_requests")
}

// Every premium period a user has ever been given — the billing ledger.
//
// User.tier/premiumUntil is the fast answer to "can they do this right now";
// this table is the history behind it, so a disputed charge or a mistaken
// admin grant can be traced. Payment webhooks will write rows here too, which
// is why `externalId` exists: it makes a provider's retry idempotent.
model PremiumGrant {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  tier        Tier        @default(PREMIUM)
  /// null = lifetime, no expiry
  expiresAt   DateTime?   @map("expires_at")
  source      GrantSource @default(ADMIN)
  /// Amount paid in so'm. Null for a manual admin grant.
  amount      Int?
  /// Provider transaction id — unique so a replayed webhook cannot double-credit.
  externalId  String?     @unique @map("external_id")
  note        String?
  grantedById String?     @map("granted_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  revokedAt   DateTime?   @map("revoked_at")

  user      User  @relation("GrantRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("GrantIssuer", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("premium_grants")
}

// Server-side record of every issued refresh token.
//
// Without this, logging out only deleted the browser cookie — a stolen refresh
// token stayed valid for its full 7-day lifetime with no way to revoke it.
// Only the SHA-256 hash is stored, so a database leak does not hand out
// usable tokens.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Profile {
  id              String    @id @default(cuid())
  userId          String    @unique @map("user_id")
  streak          Int       @default(0)
  lastLoginDate   DateTime? @map("last_login_date")
  coins           Int       @default(0)
  xp              Int       @default(0)
  league          League    @default(BRONZE)
  dailyTestCount  Int       @default(0) @map("daily_test_count")
  dailyMatchCount Int       @default(0) @map("daily_match_count")
  dailyWriteCount Int       @default(0) @map("daily_write_count")
  // The per-type counters above drive the dashboard's daily goals: they count
  // games COMPLETED and roll over with lastGameDate.
  //
  // The two below are the free-tier quota counters instead. They count every
  // game STARTED and every AI message sent, and they roll over against their
  // own `quotaDate` — a stamp of the local day they belong to. Without a
  // separate stamp a session left open past midnight would keep spending
  // yesterday's allowance, since lastGameDate only moves when a game is
  // finished.
  dailyGameCount  Int       @default(0) @map("daily_game_count")
  dailyAiCount    Int       @default(0) @map("daily_ai_count")
  dailyTtsCount   Int       @default(0) @map("daily_tts_count")
  quotaDate       DateTime? @map("quota_date")
  lastGameDate    DateTime? @map("last_game_date")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ─── Vocabulary Content ────────────────────────────────────────────────────────

// Books and topics come from two places:
//   - Official content, curated by admins — authorId is null.
//   - User-created content — authorId points at its owner.
// The main dictionary lists only official content (authorId: null); user
// content is reached through its author's profile instead. isPublic decides
// whether anyone other than the owner can see it.
model Book {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?  @map("image_url")
  authorId    String?  @map("author_id")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")

  author     User?       @relation("AuthoredBooks", fields: [authorId], references: [id], onDelete: Cascade)
  topics     Topic[]
  savedBooks SavedBook[]

  @@index([authorId])
  @@map("books")
}

model Topic {
  id       String  @id @default(cuid())
  name     String
  bookId   String? @map("book_id")
  authorId String? @map("author_id")
  isPublic Boolean @default(false) @map("is_public")

  author      User?        @relation("AuthoredTopics", fields: [authorId], references: [id], onDelete: Cascade)
  book        Book?        @relation(fields: [bookId], references: [id], onDelete: SetNull)
  wordTopics  WordTopic[]
  savedTopics SavedTopic[]

  @@index([authorId])
  @@map("topics")
}

model Word {
  id                 String   @id @default(cuid())
  japaneseWord       String   @map("japanese_word")
  hiragana           String?
  meaning            String
  exampleSentence    String?  @map("example_sentence")
  exampleTranslation String?  @map("example_translation")
  authorId           String?  @map("author_id")
  // Distinct from authorId: bulk uploads already stamp authorId with the
  // admin who imported the row, so it cannot tell official words apart from
  // ones a learner typed into their own topic. This flag can. The main
  // dictionary lists only isUserCreated: false.
  isUserCreated      Boolean  @default(false) @map("is_user_created")
  createdAt          DateTime @default(now()) @map("created_at")

  // Extended fields
  partOfSpeech       String?  @map("part_of_speech")
  jlptLevel          String?  @map("jlpt_level")
  frequency          String?
  pitchAccent        String?  @map("pitch_accent")
  teForm             String?  @map("te_form")
  taForm             String?  @map("ta_form")
  naiForm            String?  @map("nai_form")
  masuForm           String?  @map("masu_form")
  kanjiInfo          Json?    @map("kanji_info")
  additionalExamples Json?    @map("additional_examples")
  synonyms           String[] @default([])
  antonyms           String[] @default([])
  nuance             String?
  compounds          Json?
  homonyms           Json?    @map("homonyms")

  author       User?              @relation("AuthorWords", fields: [authorId], references: [id], onDelete: SetNull)
  wordTopics   WordTopic[]
  savedWords   SavedWord[]
  userProgress UserWordProgress[]
  wordNotes    UserWordNote[]

  @@index([authorId])
  @@map("words")
}

model WordTopic {
  wordId    String @map("word_id")
  topicId   String @map("topic_id")
  // Position of the word inside this topic. A textbook lesson has a fixed
  // word order, and `word.createdAt` cannot express it: a word that already
  // existed in the dictionary keeps its old timestamp when a later lesson
  // links to it, so it would sort into the wrong place. The order belongs to
  // the link, not to the word — the same word can sit at a different position
  // in another topic.
  sortOrder Int    @default(0) @map("sort_order")

  word  Word  @relation(fields: [wordId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([wordId, topicId])
  @@index([topicId, sortOrder])
  @@index([topicId])
  @@map("word_topics")
}

// ─── User ↔ Content Junctions ─────────────────────────────────────────────────

model SavedWord {
  userId  String   @map("user_id")
  wordId  String   @map("word_id")
  savedAt DateTime @default(now()) @map("saved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@index([wordId])
  @@map("saved_words")
}

model SavedBook {
  userId  String   @map("user_id")
  bookId  String   @map("book_id")
  savedAt DateTime @default(now()) @map("saved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
  @@index([bookId])
  @@map("saved_books")
}

model SavedTopic {
  userId  String   @map("user_id")
  topicId String   @map("topic_id")
  savedAt DateTime @default(now()) @map("saved_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([topicId])
  @@map("saved_topics")
}

// ─── SRS Engine ───────────────────────────────────────────────────────────────

model UserWordProgress {
  userId         String    @map("user_id")
  wordId         String    @map("word_id")
  xp             Int       @default(0) // 0–3 within current level
  level          Int       @default(1) // 1=New 2=Easy 3=Good 4=Great 5=Master
  nextReviewDate DateTime  @default(now()) @map("next_review_date")
  lastReviewedAt DateTime? @map("last_reviewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@index([userId, nextReviewDate], map: "user_word_progress_due_idx")
  @@map("user_word_progress")
}

// ─── Gamification & Leagues ───────────────────────────────────────────────────

model WeeklyStat {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  wordsLearned   Int      @default(0) @map("words_learned")
  gamesPlayed    Int      @default(0) @map("games_played")
  correctAnswers Int      @default(0) @map("correct_answers")
  totalQuestions Int      @default(0) @map("total_questions")
  coinsEarned    Int      @default(0) @map("coins_earned")
  xpEarned       Int      @default(0) @map("xp_earned")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([startDate])
  @@index([userId, startDate])
  @@map("weekly_stats")
}

model Badge {
  id          String    @id @default(cuid())
  name        String    @unique
  description String
  icon        String // emoji or icon identifier
  color       String // hex color for badge display
  badgeType   BadgeType @map("badge_type")
  threshold   Int

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

// ─── Anti-Cheat Game Sessions ─────────────────────────────────────────────────

model GameSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  wordIds   String[] @map("word_ids")
  gameType  GameType @map("game_type")
  completed Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("game_sessions")
}

// ─── League & System Logs ─────────────────────────────────────────────────────

model LeagueLog {
  id              String   @id @default(cuid())
  processedAt     DateTime @default(now()) @map("processed_at")
  weekStart       DateTime @map("week_start")
  promotionsCount Int      @default(0) @map("promotions_count")
  demotionsCount  Int      @default(0) @map("demotions_count")
  detailsJson     Json?    @map("details_json")

  @@map("league_logs")
}

model SiteConfiguration {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("site_configurations")
}

// ─── Telegram Phone Auth ──────────────────────────────────────────────────────

enum AuthSessionStatus {
  PENDING
  VERIFIED
  EXPIRED
}

model AuthSession {
  id         String            @id @default(cuid())
  token      String            @unique
  phone      String
  telegramId String?           @map("telegram_id")
  status     AuthSessionStatus @default(PENDING)
  expiresAt  DateTime          @map("expires_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  userId     String?           @map("user_id") // If it matched/created a user

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("auth_sessions")
}

model UserWordNote {
  userId    String   @map("user_id")
  wordId    String   @map("word_id")
  note      String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
  @@map("user_word_notes")
}

// ─── JLPT Mock Exams ──────────────────────────────────────────────────────────
//
// Modelled on the real test paper: an exam holds sections, a section holds
// question groups (もんだい), and a group holds questions. Anything several
// questions share — a reading passage, an audio clip, a diagram — lives on the
// group as a "stimulus" rather than being copied onto every question.

enum JlptLevel {
  N5
  N4
  N3
  N2
  N1
}

// The four parts, each independent: its own questions, its own timer, its own
// score. A learner picks a level, then a section, and works through just that
// section. Only "full exam" runs all four of a level back to back.
enum JlptSection {
  MOJI_GOI // 文字・語彙 — script and vocabulary
  BUNPOU // 文法 — grammar
  DOKKAI // 読解 — reading
  CHOUKAI // 聴解 — listening
}

// Question shapes, one per もんだい type. The runner needs these because the
// answer UI differs: SENTENCE_ORDER shows a ★ slot, listening plays audio
// before revealing choices, and so on.
enum JlptQuestionType {
  KANJI_READING // 漢字読み — kanji written above, pick the reading
  KANJI_WRITING // 表記 — kana given, pick the kanji spelling
  CONTEXT_FILL // 文脈規定 — pick the word that fits the blank
  PARAPHRASE // 言い換え類義 — pick the sentence with the same meaning
  USAGE // 用法 — pick the sentence using the word correctly (N4+)
  GRAMMAR_FILL // 文の文法1 — pick the particle or form
  SENTENCE_ORDER // 文の文法2 — order the parts, answer what lands on ★
  CLOZE_PASSAGE // 文章の文法 — consecutive blanks in one short text
  READING_SHORT // 短文
  READING_MID // 中文
  READING_LONG // 長文
  INFO_SEARCH // 情報検索 — find the answer in a notice or timetable
  LISTEN_TASK // 課題理解 — what should the person do next
  LISTEN_POINT // ポイント理解 — catch one specific detail
  LISTEN_SPEECH // 発話表現 — pick what to say in the pictured situation
  LISTEN_RESPONSE // 即時応答 — pick the natural reply
}

// Where a question came from. Official papers are copyright-bound, so the
// origin is recorded on the exam and can gate whether it may be published.
enum JlptSource {
  OFFICIAL_SAMPLE // reproduced from a published JLPT sample paper
  ORIGINAL // written for this app
}

/// A set of four tests — one per section — that make up one full mock exam.
/// Sitting the whole thing runs its four tests back to back.
model JlptExamSet {
  id          String     @id @default(cuid())
  level       JlptLevel
  title       String
  description String?
  source      JlptSource @default(ORIGINAL)
  sourceYear  Int?       @map("source_year")
  isPublished Boolean    @default(false) @map("is_published")
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tests    JlptTest[]
  attempts JlptAttempt[]

  @@index([level, isPublished])
  @@map("jlpt_exam_sets")
}

/// One practice test inside one section of one level — "Moji · Goi — 1-test".
///
/// This is the unit a learner opens and works through. Sections do not share
/// questions or clocks: a test belongs to exactly one level and one section,
/// and carries its own timer. A test may additionally belong to an exam set,
/// which is what the "full exam" button assembles.
model JlptTest {
  id          String      @id @default(cuid())
  level       JlptLevel
  section     JlptSection
  /// Position within its section: 1 for "1-test", 2 for "2-test".
  number      Int
  title       String?
  /// Minutes for this test on its own.
  minutes     Int
  source      JlptSource  @default(ORIGINAL)
  sourceYear  Int?        @map("source_year")
  /// Draft tests are visible to admins only.
  isPublished Boolean     @default(false) @map("is_published")
  setId       String?     @map("set_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  set      JlptExamSet?        @relation(fields: [setId], references: [id], onDelete: SetNull)
  groups   JlptQuestionGroup[]
  attempts JlptAttempt[]

  @@unique([level, section, number])
  @@index([level, section, isPublished])
  @@index([setId])
  @@map("jlpt_tests")
}

model JlptQuestionGroup {
  id            String           @id @default(cuid())
  testId        String           @map("test_id")
  /// The もんだい number as printed on the paper.
  number        Int
  type          JlptQuestionType
  /// The Japanese instruction line shown above the questions.
  instruction   String           @db.Text
  /// Uzbek translation of the instruction, for learners who cannot read it yet.
  instructionUz String?          @db.Text

  // ── Shared material ──
  /// Reading passage, cloze text, or listening transcript.
  passage  String? @db.Text
  /// Diagram, notice or timetable that the questions refer to.
  imageUrl String? @map("image_url")
  /// Listening clip for the whole group, when the questions share one recording.
  audioUrl String? @map("audio_url")

  sortOrder Int @default(0) @map("sort_order")

  test      JlptTest       @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions JlptQuestion[]

  @@unique([testId, number])
  @@map("jlpt_question_groups")
}

model JlptQuestion {
  id            String  @id @default(cuid())
  groupId       String  @map("group_id")
  /// Question number as printed, unique within the exam paper.
  number        Int
  /// The sentence or prompt. For SENTENCE_ORDER the ★ position is marked with
  /// the literal ★ character; for pure-audio questions it may be empty.
  stem          String  @db.Text
  /// The word or phrase underlined in the stem, when the question asks about it.
  focus         String?
  /// Illustration belonging to this question alone (common in listening).
  imageUrl      String? @map("image_url")
  /// Clip for this question alone.
  audioUrl      String? @map("audio_url")
  /// What is said in a listening item. Read aloud by the app's Japanese voice
  /// while no recording exists, and shown in the review afterwards.
  transcript    String? @db.Text
  /// Points. The real test scales scores; here every question is worth 1 by
  /// default and the report says the result is approximate.
  points        Int     @default(1)
  /// Why the answer is right — written in Uzbek, shown after the attempt.
  explanationUz String? @db.Text

  group   JlptQuestionGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  choices JlptChoice[]
  answers JlptAttemptAnswer[]

  @@unique([groupId, number])
  @@map("jlpt_questions")
}

model JlptChoice {
  id         String  @id @default(cuid())
  questionId String  @map("question_id")
  /// 1–4 as printed.
  number     Int
  text       String  @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")

  question JlptQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, number])
  @@map("jlpt_choices")
}

enum JlptAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model JlptAttempt {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  /// Exactly one of these is set: a single test for a section drill, or an
  /// exam set for the full mock exam.
  testId        String?           @map("test_id")
  setId         String?           @map("set_id")
  status        JlptAttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime          @default(now()) @map("started_at")
  finishedAt    DateTime?         @map("finished_at")
  /// Filled on completion.
  score         Int?
  maxScore      Int?              @map("max_score")
  /// Per-section raw scores, so the report can apply the JLPT rule that every
  /// block needs a minimum, not just the total.
  sectionScores Json?             @map("section_scores")
  passed        Boolean?

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  test    JlptTest?           @relation(fields: [testId], references: [id], onDelete: Cascade)
  set     JlptExamSet?        @relation(fields: [setId], references: [id], onDelete: Cascade)
  answers JlptAttemptAnswer[]

  @@index([userId, status])
  @@map("jlpt_attempts")
}

model JlptAttemptAnswer {
  id         String   @id @default(cuid())
  attemptId  String   @map("attempt_id")
  questionId String   @map("question_id")
  /// Chosen option number, or null when the learner left it blank.
  chosen     Int?
  isCorrect  Boolean? @map("is_correct")
  answeredAt DateTime @default(now()) @map("answered_at")

  attempt  JlptAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question JlptQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("jlpt_attempt_answers")
}
