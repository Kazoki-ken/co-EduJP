# Deployment credentials — copy to `.env.deploy` (gitignored) and fill in.
# NEVER commit the real values.

DEPLOY_HOST=your.server.ip
DEPLOY_USER=deploy
DEPLOY_PORT=22
DEPLOY_APP_DIR=/var/www/vocabjp

# Preferred: SSH key authentication
DEPLOY_SSH_KEY=C:\Users\you\.ssh\id_ed25519
# DEPLOY_SSH_PASSPHRASE=

# Fallback: password authentication (less secure — prefer a key)
# DEPLOY_PASSWORD=
